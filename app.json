{
  "expo": {
    "name": "Kisan Sevak",
    "slug": "kisan-sevak",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1B5E20"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kisan.sevak"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B5E20"
      },
      "package": "com.kisan.sevak",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {},
    "description": "आपका डिजिटल कृषि सहायक - Your Digital Farming Assistant",
    "githubUrl": "https://github.com/yourusername/kisan-sevak",
    "plugins": [
      "expo-image-picker",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "5d9fc995-8509-4153-9492-a47a3cc742c8"
      }
    }
  }
}
